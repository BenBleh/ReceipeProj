<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Nibbles.RecipeDetailsPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Nibbles.Models"
             xmlns:components="clr-namespace:Nibbles.Components"
             xmlns:vm="clr-namespace:Nibbles.ViewModels"
             x:DataType="vm:RecipeDetailsViewModel"
             Shell.NavBarIsVisible="False" Title="Recipe">
    <Grid Padding="24,8,24,12" RowDefinitions="Auto,*,Auto" RowSpacing="12" MaximumWidthRequest="1000" HorizontalOptions="Fill">
        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
            <Button Text="←" Style="{StaticResource QuietButton}" Clicked="Back_Clicked" SemanticProperties.Description="Back to recipe box" />
            <Label Grid.Column="1" Text="Recipe" FontSize="18" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Edit" Style="{StaticResource QuietButton}" Command="{Binding EditRecipeCommand}" IsVisible="{Binding CanAdd}" />
        </Grid>
        <ScrollView x:Name="DetailsScroll" Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="0,0,0,16">
                <Label Text="{Binding ErrorMessage}" Style="{StaticResource ErrorLabel}">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding ErrorMessage}" Value=""><Setter Property="IsVisible" Value="False" /></DataTrigger></Label.Triggers>
                </Label>
                <Border StrokeThickness="0">
                    <Image Source="{Binding Recipe.ImagePath}" HeightRequest="{OnIdiom Phone=220, Tablet=300, Desktop=340}" Aspect="AspectFill" />
                </Border>
                <Label Text="{Binding Recipe.Title}" Style="{StaticResource PageHeading}" />
                <HorizontalStackLayout Spacing="12">
                    <Button Text="↗  Original recipe" Style="{StaticResource SecondaryButton}" Command="{Binding OpenLinkCommand}" IsVisible="{Binding HasSourceLink}" />
                </HorizontalStackLayout>
                <Label x:Name="NotesLabel" Text="{Binding Recipe.Notes}" IsVisible="{Binding HasNotes}" Style="{StaticResource MutedLabel}" FontSize="15" />
                <VerticalStackLayout Spacing="12" IsVisible="{Binding HasResume}">
                    <Label Text="Continue from earlier today" Style="{StaticResource SectionHeading}" />
                    <Button Text="Resume cooking" Clicked="Resume_Clicked" />
                    <Button Text="Start fresh…" Style="{StaticResource QuietButton}" Clicked="StartFresh_Clicked" />
                </VerticalStackLayout>
                <Button Text="Start cooking" IsVisible="{Binding IsFresh}" Clicked="StartCooking_Clicked" />
                <Button Text="{Binding ScaleLabel}" Style="{StaticResource SecondaryButton}" Clicked="Scale_Clicked" />
                <Label Text="Method amounts, temperatures and durations remain original." IsVisible="{Binding IsScaled}" Style="{StaticResource MutedLabel}" FontSize="13" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <Button Text="Ingredients" Style="{StaticResource QuietButton}" Command="{Binding ShowIngredientsCommand}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsIngredients}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Tint}, Dark={StaticResource DarkSurface}}" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="Method" Style="{StaticResource QuietButton}" Command="{Binding ShowMethodCommand}">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding IsMethod}" Value="True"><Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Tint}, Dark={StaticResource DarkSurface}}" /></DataTrigger></Button.Triggers>
                    </Button>
                </Grid>
                <VerticalStackLayout IsVisible="{Binding IsIngredients}" Spacing="16">
                    <VerticalStackLayout x:Name="IngredientGroups" Spacing="24" BindableLayout.ItemsSource="{Binding IngredientSections}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:IngredientSection">
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding ShowHeading}">
                                        <Label Text="{Binding Name}" FontFamily="OpenSansSemibold" />
                                        <Label Grid.Column="1" Text="{Binding Summary}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
                                    </Grid>
                                    <VerticalStackLayout Spacing="6" BindableLayout.ItemsSource="{Binding Ingredients}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:Ingredient">
                                                <components:IngredientItemView />
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
                <VerticalStackLayout x:Name="MethodSteps" IsVisible="{Binding IsMethod}" Spacing="24" BindableLayout.ItemsSource="{Binding Recipe.Steps}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Step">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{Binding StepNumberDisplay}" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource DarkInk}}" />
                                <Label Text="{Binding Instructions}" FontSize="17" LineHeight="1.35" />
                            </VerticalStackLayout>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        <VerticalStackLayout Grid.Row="2" Spacing="8" IsVisible="{Binding IsIngredients}">
        <Button Text="Clear checked" Style="{StaticResource QuietButton}" Command="{Binding ClearChecksCommand}" IsVisible="{Binding HasChecks}" />
        <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="10">
            <Button Text="{Binding CopyLabel}" Style="{StaticResource SecondaryButton}" Command="{Binding CopyIngredientsCommand}" />
            <Button Grid.Column="1" Text="Method →" Command="{Binding ShowMethodCommand}" />
        </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
