<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Nibbles.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Nibbles.Models"
             xmlns:vm="clr-namespace:Nibbles.ViewModels"
             xmlns:local="clr-namespace:Nibbles"
             x:DataType="vm:MainPageViewModel"
             Shell.NavBarIsVisible="False" Title="Nibbles"
             SizeChanged="Page_SizeChanged">
    <Grid Padding="24,12,24,12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="16"
          MaximumWidthRequest="1440" HorizontalOptions="Fill">
        <VerticalStackLayout Spacing="12">
            <HorizontalStackLayout Spacing="10">
                <Image Source="nibbles_chef.png" HeightRequest="48" WidthRequest="40" SemanticProperties.Description="Nibbles chef cat" />
                <Label Text="Nibbles" FontSize="28" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Label Text="Your recipes, ready to cook." Style="{StaticResource MutedLabel}" FontSize="15" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Style="{StaticResource Field}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="{x:Static local:IconFont.Search}" FontFamily="IconFonts" FontSize="22" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding SearchQuery}" Placeholder="Titles, ingredients, notes and method" FontSize="14"
                       ClearButtonVisibility="WhileEditing" ReturnType="Search" SemanticProperties.Description="Search titles, ingredients, notes and method" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
            <Label Text="Your recipe box" FontSize="19" VerticalOptions="Center" />
            <Label Grid.Column="1" Text="{Binding RecipeCount}" Style="{StaticResource MutedLabel}" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="Refresh" Style="{StaticResource QuietButton}" Command="{Binding RefreshCommand}"
                    SemanticProperties.Description="Refresh recipes from GitHub" />
        </Grid>
        <RefreshView Grid.Row="3" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="recipeListCollectionView" ItemsSource="{Binding RecipeListItems}"
                            SelectionMode="Single" SelectionChanged="OnCollectionViewSelectionChanged">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="RecipeGrid" Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="16,36" Spacing="12">
                        <Image Source="nibbles_chef.png" HeightRequest="88" />
                        <Label Text="{Binding EmptyTitle}" HorizontalTextAlignment="Center" Style="{StaticResource SectionHeading}" />
                        <Label Text="Try another ingredient or a shorter phrase." IsVisible="{Binding IsSearching}"
                               Style="{StaticResource MutedLabel}" HorizontalTextAlignment="Center" />
                        <Button Text="Clear search" IsVisible="{Binding IsSearching}" Command="{Binding ClearSearchCommand}" Style="{StaticResource SecondaryButton}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecipeListItem">
                        <Border StrokeThickness="0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Image Source="{Binding ImageData}" Aspect="AspectFill" HeightRequest="{OnIdiom Phone=152, Tablet=180, Desktop=210}"
                                       SemanticProperties.Description="{Binding Title, StringFormat='Recipe image for {0}'}" />
                                <Label Grid.Row="1" Text="{Binding Title}" Margin="12,12,12,14"
                                       FontSize="14" MaxLines="2" MinimumHeightRequest="40" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Text="{Binding MatchLabel}" IsVisible="{Binding HasMatch}" Margin="12,0,12,8"
                                       FontFamily="OpenSansSemibold" FontSize="12" />
                                <Label Grid.Row="3" Text="{Binding MatchExcerpt}" IsVisible="{Binding HasMatch}" Margin="12,0,12,16"
                                       FontSize="15" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <Label Text="Updating recipe search…" IsVisible="{Binding IsIndexing}" Style="{StaticResource MutedLabel}" FontSize="12" />
            <Button Text="+  Add recipe" HorizontalOptions="End" Clicked="AddButton_Clicked" IsEnabled="{Binding CanAdd}" />
            <Label Text="{Binding StatusMessage}" Style="{StaticResource MutedLabel}" FontSize="11" HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <Border Grid.RowSpan="5" IsVisible="{Binding IsBusy}" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E6F7F5F0, Dark=#E6172320}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="12">
                <Image Source="nibbles_chef.png" HeightRequest="76" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="Opening your recipe box…" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsIndexing}" Value="True"><Setter Property="Text" Value="Updating recipe search…" /></DataTrigger></Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
