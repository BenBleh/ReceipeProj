<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Nibbles.MainPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Nibbles.Models"
             xmlns:vm="clr-namespace:Nibbles.ViewModels"
             xmlns:local="clr-namespace:Nibbles"
             xmlns:components="clr-namespace:Nibbles.Components"
             x:DataType="vm:MainPageViewModel"
             Shell.NavBarIsVisible="False" Title="Nibbles"
             SizeChanged="Page_SizeChanged">
    <Grid Padding="24,12,24,12" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12"
          MaximumWidthRequest="1440" HorizontalOptions="Fill">
        <HorizontalStackLayout Spacing="10">
                <Image Source="nibbles_chef.png" HeightRequest="48" WidthRequest="40" SemanticProperties.Description="Nibbles chef cat" />
                <Label Text="Nibbles" FontSize="28" FontFamily="OpenSansSemibold" VerticalOptions="Center" />
        </HorizontalStackLayout>
        <VerticalStackLayout Grid.Row="1" Spacing="12">
        <Border Style="{StaticResource Field}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <Label Text="{x:Static local:IconFont.Search}" FontFamily="IconFonts" FontSize="22" VerticalOptions="Center" />
                <Entry Grid.Column="1" Text="{Binding SearchQuery}" Placeholder="Titles, ingredients, notes and method" FontSize="14"
                       ClearButtonVisibility="WhileEditing" ReturnType="Search" SemanticProperties.Description="Search titles, ingredients, notes and method" />
            </Grid>
        </Border>
        <components:ClassificationChoices SelectedClassification="{Binding SelectedClassification, Mode=TwoWay}"
                                          AllowClearing="True" AutomationId="LibraryClassificationChoices" />
        <Border IsVisible="{Binding HasStatusMessage}" Padding="12" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Tint}, Dark={StaticResource DarkSurface}}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding StatusMessage}" VerticalOptions="Center" FontSize="13" />
                <Button Grid.Column="1" Text="Retry" components:ButtonIcon.Glyph="{x:Static local:IconFont.RefreshCw}"
                        Command="{Binding RefreshCommand}" Style="{StaticResource QuietButton}" />
            </Grid>
        </Border>
        </VerticalStackLayout>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label Text="{Binding LibraryHeading}" FontSize="19" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="Refresh" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}"
                    components:ButtonIcon.Glyph="{x:Static local:IconFont.RefreshCw}"
                    SemanticProperties.Description="Refresh recipes from GitHub" />
        </Grid>
        <Grid Grid.Row="3">
        <RefreshView IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}">
            <CollectionView x:Name="recipeListCollectionView" ItemsSource="{Binding RecipeListItems}"
                            SelectionMode="Single" SelectionChanged="OnCollectionViewSelectionChanged">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="RecipeGrid" Orientation="Vertical" Span="2" HorizontalItemSpacing="12" VerticalItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RecipeListItem">
                        <Border StrokeThickness="0">
                            <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                <Grid>
                                    <Label Text="{x:Static local:IconFont.Image}" FontFamily="IconFonts" FontSize="32"
                                           HorizontalOptions="Center" VerticalOptions="Center" Style="{StaticResource MutedLabel}"
                                           AutomationProperties.IsInAccessibleTree="False" />
                                    <Image Source="{Binding ImageData}" Aspect="AspectFill" HeightRequest="132" SizeChanged="RecipeImage_SizeChanged"
                                           SemanticProperties.Description="{Binding Title, StringFormat='Recipe image for {0}'}" />
                                </Grid>
                                <Label Grid.Row="1" Text="{Binding Title}" Margin="12,12,12,14"
                                       FontSize="14" MaxLines="2" MinimumHeightRequest="40" LineBreakMode="TailTruncation" />
                                <Label Grid.Row="2" Text="{Binding MatchLabel}" IsVisible="{Binding HasMatch}" Margin="12,0,12,8"
                                       FontFamily="OpenSansSemibold" FontSize="12" />
                                <Label Grid.Row="3" Text="{Binding MatchExcerpt}" IsVisible="{Binding HasMatchExcerpt}" Margin="12,0,12,16"
                                       FontSize="15" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
        <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="16,36" Spacing="12" VerticalOptions="Center">
            <Label Text="{Binding EmptyTitle}" HorizontalTextAlignment="Center" Style="{StaticResource SectionHeading}" />
            <Button Text="Clear search" IsVisible="{Binding IsSearching}" Command="{Binding ClearSearchCommand}"
                    Style="{StaticResource SecondaryButton}" HorizontalOptions="Center" />
        </VerticalStackLayout>
        </Grid>
        <VerticalStackLayout Grid.Row="4" Spacing="8">
            <Label Text="Updating recipe search…" IsVisible="{Binding IsIndexing}" Style="{StaticResource MutedLabel}" FontSize="12" />
            <Button Text="Add recipe" components:ButtonIcon.Glyph="{x:Static local:IconFont.Plus}"
                    Padding="12,10" HorizontalOptions="End" Clicked="AddButton_Clicked" IsEnabled="{Binding CanAdd}" />
        </VerticalStackLayout>
        <Border Grid.RowSpan="5" IsVisible="{Binding IsBusy}" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E6F7F5F0, Dark=#E6172320}">
            <VerticalStackLayout VerticalOptions="Center" Spacing="12">
                <Image Source="nibbles_chef.png" HeightRequest="76" />
                <ActivityIndicator IsRunning="{Binding IsBusy}" />
                <Label Text="Opening your recipe box…" HorizontalTextAlignment="Center" Style="{StaticResource MutedLabel}">
                    <Label.Triggers><DataTrigger TargetType="Label" Binding="{Binding IsIndexing}" Value="True"><Setter Property="Text" Value="Updating recipe search…" /></DataTrigger></Label.Triggers>
                </Label>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
